# NetFlux — root environment placeholders (copy to .env: make init)

# PostgreSQL
DATABASE_URL=postgresql+psycopg://netflux:netflux@localhost:5432/netflux

# Redis
REDIS_URL=redis://localhost:6379/0

# MQTT
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883

# Backend entry service (main)
MAIN_HOST=0.0.0.0
MAIN_PORT=8000

# Satellite microservice ports (local development)
VIDEO_CONVERT_PORT=8001
VIDEO_PLAYER_PORT=8002
BOOKMARKS_PORT=8003
SEARCH_PORT=8004
STATS_PORT=8005

# Frontend dev server
VITE_API_BASE_URL=http://localhost:8000
